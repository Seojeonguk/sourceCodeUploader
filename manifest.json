{
  "manifest_version": 3,
  "name": "Source Code Uploader",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "description": "A extension enabling seamless uploading of source code to platforms.",
  "key": "",
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_title": "Source Code Uploader",
    "default_popup": "popup/html/index.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://school.programmers.co.kr/learn/courses/*/lessons/*",
        "https://programmers.co.kr/learn/courses/*/lessons/*"
      ],
      "css": ["scripts/programmers/programmers.css"],
      "js": [
        "scripts/programmers/helpers.js",
        "scripts/programmers/index.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["scripts/github/handlers/oauthHandler.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://github.com/*",
    "https://school.programmers.co.kr/*",
    "https://programmers.co.kr/*"
  ],
  "permissions": ["storage"],
  "short_name": "SCU",
  "web_accessible_resources": [
    {
      "resources": ["icon/*.png"],
      "matches": [
        "https://school.programmers.co.kr/*",
        "https://programmers.co.kr/*"
      ]
    },
    {
      "resources": ["scripts/programmers/sourceExtractor.js"],
      "matches": [
        "https://school.programmers.co.kr/*",
        "https://programmers.co.kr/*"
      ]
    }
  ]
}
